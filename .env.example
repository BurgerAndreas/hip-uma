# Copy this file to .env and replace every placeholder needed by your setup.
# .env is gitignored and is sourced as a shell file by the submission helpers.

# SLURM settings. Leave SLURM_ACCOUNT empty if your cluster supplies a default.
SLURM_ACCOUNT=your_slurm_account
SLURM_GPU_PARTITION=your_gpu_partition
SLURM_EVAL_PARTITION=your_gpu_partition
SLURM_CPU_PARTITION=your_cpu_partition

# Weights & Biases. Set WANDB_MODE=disabled to run without W&B.
WANDB_ENTITY=your_wandb_entity
WANDB_PROJECT=uma
WANDB_MODE=online

# Local caches and downloaded source data.
FAIRCHEM_CACHE_DIR=.cache/fairchem
KAGGLEHUB_CACHE=data/kagglehub

# Snapshot roots used by configs/pretrained/model_configs/*.yaml.
UMA_MODEL_ROOT=/path/to/models--facebook--UMA/snapshots/REVISION
OMOL25_MODEL_ROOT=/path/to/models--facebook--OMol25/snapshots/REVISION
